# Fill in with your Supabase project values, then copy this block into BOTH
# .env.local (used by `pnpm dev` / `next build` run directly on the host) AND
# .env (used by `docker compose build`, which passes these as build args to
# infra/Dockerfile.gateway — Next.js inlines NEXT_PUBLIC_* at build time, so
# docker-compose's `environment:` alone is too late to affect the client bundle).
# The publishable key is public (safe for NEXT_PUBLIC_); never expose a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy compatibility name; the Gateway falls back to this when publishable key is absent.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Image upload relay (G-05, optional). Server-only — never NEXT_PUBLIC_,
# never sent to the browser, never committed. Bypasses Storage RLS, so the
# bucket itself must stay write-server-only. Setup steps (create the
# bucket, copy this key from the Supabase dashboard): runbooks/image-upload-setup.md.
# The Gateway starts and runs fine without this set; only POST
# /api/uploads/image fails (500) until it's configured.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=artwork-images

# Internal service URLs. The browser must never use these directly.
ACCOUNT_SERVICE_URL=http://localhost:4101
CATALOG_DISCOVERY_SERVICE_URL=http://localhost:4102
ARTIST_ARTWORK_SERVICE_URL=http://localhost:4103
COMMERCE_SERVICE_URL=http://localhost:4104
RECOMMENDATION_SERVICE_URL=http://localhost:4105
VERIFICATION_SERVICE_URL=http://localhost:4106
ROOM_PREVIEW_SERVICE_URL=http://localhost:4107
ADMIN_SERVICE_URL=http://localhost:4108

# Catalog discovery reads the artist/artwork source service through this internal URL.

ACCOUNT_PORT=4101
CATALOG_DISCOVERY_PORT=4102
ARTIST_ARTWORK_PORT=4103
COMMERCE_PORT=4104
RECOMMENDATION_PORT=4105
VERIFICATION_PORT=4106
ROOM_PREVIEW_PORT=4107
ADMIN_PORT=4108

# Local PostgreSQL for service-owned persistence.
DATABASE_URL=postgresql://atelier:atelier_local_dev@localhost:5432/atelier
DB_POOL_MAX=10

# Shared server-side credential for Gateway and service-to-service business calls.
# Never expose this value to the browser or commit a real secret.
# REQUIRED: `docker compose` fails closed when it is unset — there is no default.
ATELIER_INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-secret

# Escape hatch ONLY for running a single service directly on the host
# outside Docker Compose (e.g. `pnpm --filter @atelier/account-service dev`
# without also setting the token) — every service otherwise refuses to
# start without ATELIER_INTERNAL_SERVICE_TOKEN set (packages/config/src/http.ts).
# Never set this in docker-compose.yml, CI, or any deployed environment.
ATELIER_ALLOW_INSECURE_LOCAL=false

# Signs/verifies the short-lived caller-identity assertion (`x-principal`
# header) the Gateway attaches to /v1/account/me calls after validating the
# caller's Supabase session (G-19) — deliberately separate from
# ATELIER_INTERNAL_SERVICE_TOKEN above, which every one of the 8 services
# holds and only proves "inside the network," not "on behalf of this user."
# Only web-gateway (signs) and account-service (verifies) need this value.
# REQUIRED: `docker compose` fails closed when it is unset — there is no default.
ATELIER_PRINCIPAL_SIGNING_SECRET=replace-with-a-long-random-secret

# Stripe (test mode). Needed by BOTH commerce-service (creates Checkout
# Sessions) and web-gateway (verifies webhook signatures, Phase 6 G-04) —
# never NEXT_PUBLIC_, never reaches the browser. Get it from the Stripe
# dashboard's Developers > API keys page. See runbooks/stripe-integration.md.
STRIPE_SECRET_KEY=sk_test_replace-with-your-test-secret-key

# Verifies the `stripe-signature` header on POST /api/webhooks/stripe
# (web-gateway only, G-04) — the webhook is now the authoritative source for
# payment state; the redirect-poll /checkout/confirm route stays as a
# degraded fallback for when the webhook hasn't arrived yet. For local dev,
# run `stripe listen --forward-to http://localhost:3000/api/webhooks/stripe
# --print-secret` (Stripe CLI) to get a real value — the webhook route
# returns 500 with a clear message if this is left unset, rather than
# silently accepting unverified events.
STRIPE_WEBHOOK_SECRET=whsec_replace-with-your-webhook-signing-secret

# The public URL the buyer's browser returns to after Stripe Checkout.
# Must be reachable from the browser (not a Docker service name) — defaults
# to localhost for local dev; set to the real domain in a deployment.
WEB_GATEWAY_URL=http://localhost:3000
