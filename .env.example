# Copy to .env.local and fill in with your Supabase project values.
# The anon key is public (safe for NEXT_PUBLIC_); never expose the service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Internal service URLs. The browser must never use these directly.
ACCOUNT_SERVICE_URL=http://localhost:4101
CATALOG_DISCOVERY_SERVICE_URL=http://localhost:4102
ARTIST_ARTWORK_SERVICE_URL=http://localhost:4103
COMMERCE_SERVICE_URL=http://localhost:4104
RECOMMENDATION_SERVICE_URL=http://localhost:4105
VERIFICATION_SERVICE_URL=http://localhost:4106
ROOM_PREVIEW_SERVICE_URL=http://localhost:4107
ADMIN_SERVICE_URL=http://localhost:4108

# Catalog discovery reads the artist/artwork source service through this internal URL.

ACCOUNT_PORT=4101
CATALOG_DISCOVERY_PORT=4102
ARTIST_ARTWORK_PORT=4103
COMMERCE_PORT=4104
RECOMMENDATION_PORT=4105
VERIFICATION_PORT=4106
ROOM_PREVIEW_PORT=4107
ADMIN_PORT=4108

# Local PostgreSQL for service-owned persistence.
DATABASE_URL=postgresql://atelier:atelier_local_dev@localhost:5432/atelier
DB_POOL_MAX=10

# Shared server-side credential for Gateway and service-to-service business calls.
# Never expose this value to the browser or commit a real secret.
ATELIER_INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-secret
