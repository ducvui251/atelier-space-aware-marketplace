FROM node:24-bookworm-slim

WORKDIR /app
RUN npm install --global pnpm@10.34.5

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages ./packages
COPY services ./services
COPY apps ./apps

# pnpm does not symlink optionalDependencies by default; sharp's native binding
# (@img/sharp-linux-x64) lives in the pnpm store but is not linked under
# sharp/node_modules/@img/. Hoist it manually so Next.js image optimiser works.
RUN echo 'public-hoist-pattern[]=@img/*' > .npmrc && \
    pnpm install --frozen-lockfile

# next build requires sharp for image optimisation. The hoist above makes it
# findable, but the postinstall binary-copy step still needs to run.
RUN pnpm --filter @atelier/web-gateway exec node -e "require('sharp/install')" 2>/dev/null || true

# Next.js inlines NEXT_PUBLIC_* variables into the build output at build
# time, even in server-side code — setting them at runtime (docker-compose
# `environment:`) is too late. They must be passed as build args instead.
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_PUBLIC_SUPABASE_URL=${NEXT_PUBLIC_SUPABASE_URL}
ENV NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=${NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY}
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=${NEXT_PUBLIC_SUPABASE_ANON_KEY}

RUN pnpm --filter @atelier/web-gateway build

CMD ["pnpm", "--filter", "@atelier/web-gateway", "start"]
